  <property name="styleSheet">
   <string notr="true">/* ──────────────────────────────────────────────────────────────
   Minimal Dark Theme · Qt Widgets QSS
   Paleta base:
     bg        #121417
     surface   #1A1D21
     surface+  #20252B
     border    #2B3036
     text      #E6E6E6
     text-2    #A6A6A6
     text-dis  #6B6F76
     accent    #4C8DFF
     accent-2  #2E6CF3
   Radios/bordes pequeños, sin sombras, sin degradados.
   ────────────────────────────────────────────────────────────── */

/* Base */
QWidget {
  background: #121417;
  color: #E6E6E6;
  font-size: 16px;
}

*:disabled {
  color: #6B6F76;
}

/* Ventanas y contenedores */
QMainWindow, QDialog, QFrame, QStackedWidget, QSplitter {
  background: #121417;
  border: none;
}

/* Barras y menús */
QMenuBar {
  background: #121417;
  border: none;
}
QMenuBar::item {
  padding: 4px 8px;
  background: transparent;
}
QMenuBar::item:selected {
  background: #20252B;
  border-radius: 6px;
}
QMenu {
  background: #181B20;
  border: 1px solid #2B3036;
}
QMenu::item {
  padding: 6px 10px;
}
QMenu::item:selected {
  background: #20252B;
}

/* Botones */
QPushButton, QToolButton {
  background: #1A1D21;
  color: #E6E6E6;
  border: 1px solid #2B3036;
  border-radius: 8px;
  padding: 6px 12px;
}
QPushButton:hover, QToolButton:hover {
  background: #20252B;
  border-color: #3A4048;
}
QPushButton:pressed, QToolButton:pressed {
  background: #15181D;
}
QPushButton:default {
  background: #4C8DFF;
  color: #FFFFFF;
  border: 1px solid #4C8DFF;
}
QPushButton:disabled, QToolButton:disabled {
  background: #1A1D21;
  color: #6B6F76;
  border-color: #24292F;
}

/* Campos de texto */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QDateTimeEdit, QDateEdit, QTimeEdit {
  background: #0F1216;
  color: #E6E6E6;
  border: 1px solid #2B3036;
  border-radius: 8px;
  padding: 6px 8px;
  selection-background-color: #2E6CF3;
  selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus,
QDateEdit:focus, QTimeEdit:focus {
  border-color: #4C8DFF;
}

/* SpinBox up/down */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateTimeEdit::up-button, QDateEdit::up-button, QTimeEdit::up-b
</string>
