# .env.prod.example - Production environment variables template
# Copy to .env.prod and fill in actual values

# === Database Configuration ===
POSTGRES_PASSWORD=your-secure-postgres-password-here

# === Security ===
JWT_SECRET_KEY=your-jwt-secret-key-here
API_KEY=your-api-key-here

# === Monitoring ===
GRAFANA_PASSWORD=your-grafana-password-here

# === External Services ===
# Chess.com API (if needed)
CHESS_COM_API_KEY=your-chess-com-api-key-here

# === Performance Tuning ===
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis
REDIS_MAX_MEMORY=512mb

# Stockfish
STOCKFISH_DEPTH=15

# === Logging ===
LOG_LEVEL=INFO
ENABLE_TRACING=true

# === Scaling ===
BACKEND_REPLICAS=2
CELERY_REPLICAS=2
CELERY_TORCH_REPLICAS=1

# === SSL/TLS (if using HTTPS) ===
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# === Backup Configuration ===
# BACKUP_RETENTION_DAYS=30
# BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# === Resource Limits ===
# Backend
BACKEND_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=1G

# Celery Workers
CELERY_CPU_LIMIT=2.0
CELERY_MEMORY_LIMIT=2G

# PyTorch Workers
TORCH_CPU_LIMIT=2.0
TORCH_MEMORY_LIMIT=4G

# Database
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G